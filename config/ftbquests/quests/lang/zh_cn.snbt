	quest.507FFB6534902FBA.quest_desc: [
		"&a你有&e动力搅拌器&a和&e工作盆&a了吗？如果没有，先准备好它们。"
		""
		"{ \"text\": \"点击跳转：动力搅拌器\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5F6A3C29FC3450BC\" } }"
		"{@pagebreak}"
		"&a将&e铜锭&a和&e锌锭&a扔入&e工作盆&a。"
		""
