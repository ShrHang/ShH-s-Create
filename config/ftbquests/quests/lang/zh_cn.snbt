	quest.6A10338F82E25563.quest_subtitle: "什么叫不死图腾也有不死图腾？"
	quest.6AB904638C1A02BD.quest_subtitle: "击杀唤魔者掉落"
	quest.6AC18F92931A467E.quest_desc: [
		"&a奥术铁砧具有三个功能：&d注魔&a、&b升级&a、&e强化&a。"
		"{@pagebreak}"
		"&a功能一：&d注魔"
		""
		"&a您可以&e将法术卷轴注入任意装备&a。"
		"{image:kubejs:textures/ftbquests/arcane_anvil-1.png width:150 height:90 align:center}"
		"{image:kubejs:textures/ftbquests/arcane_anvil-2.png width:150 height:90 align:center}"
		""
		"&a当您装备了注入法术的装备时，您可以消耗法力值释放该法术，并且&6冷却时间只有正常释放的50%&a。"
		"{@pagebreak}"
		"&a功能二：&b升级"
		""
		"&a您可以&b使用墨水来升级法术卷轴&a。"
		"{image:kubejs:textures/ftbquests/arcane_anvil-3.png width:190 height:100 align:center}"
		"&a每次升级&b只能升一级&a，并且只能使用&e当前等级对应品质&a的墨水，（如&7普通3&6->&7普通4&a需要&7普通墨水&a）"
		"{ \"text\": \"墨水\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3582FFA1F1C556F2\" } }"
		"&a若下一次升级将&b升到更高一级品质&a，则需要用&e对应品质的墨水&a。（如&7普通4&6->&2卓越5&a需要&2卓越墨水&a）"
		"{image:kubejs:textures/ftbquests/arcane_anvil-4.png width:180 height:90 align:center}"
		"{@pagebreak}"
		"&a功能三：&e强化"
		""
		"&a您可以使用&e升级法术球&a给&c护甲、武器、法杖、法术书&a强化，至多&c强化20次&a。"
		"{image:kubejs:textures/ftbquests/arcane_anvil-5.png width:200 height:100 align:center}"
		""
		"&a强化后的装备将获得&e对应升级法术的属性效果&a。"
		""
		"&b装备的法术强化是铁魔法后期重要的数值来源。"
		""
		"{ \"text\": \"法术升级球\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"5A53D8AA737480DC\" } }"
	]
	quest.6AC18F92931A467E.quest_subtitle: "给您的武器装备注入魔法。"
	quest.6ACBD05D3E554657.quest_subtitle: "现在，它可以通过击杀对应词条的怪物掉落获取。"
	quest.6B0C072AA2D028F9.quest_desc: [
		"&a基于&e红石&a的&6红石元件&a可实现更方便的&6延迟&a、&6中继&a、&6信号延长&a、&6定时触发&a和&6远程遥控&a。"
		""
		"&a需要时前往&e物流与自动化&a章节查看。"
	]
	quest.6B0C072AA2D028F9.quest_subtitle: "高级红石元件"
	quest.6B0C072AA2D028F9.title: "需要远程控制？"
	quest.6B65CB16A7C09F97.quest_desc: [
		"&b交流发电机&a是本包获取电力的唯一途径。"
		"{@pagebreak}"
		"&a电力以为&bFE&a单位，为与模组统一口径，下文将以FE指代电力。"
		""
		"&a通过向交流发电机施加应力，即可将应力转化为FE。要使交流发电力能够正常发电，需要使其达到至少&b30RPM&a的转速。"
		"{@pagebreak}"
		"&a应力消耗量为&e64su/RPM&a。转速越高，转化速率越高，可从&b42FE/t&a提高至最多&b360FE/t&a。"
		""
		"&a交流发电机可以储存&b5kFE&a的电力。"
	]
	quest.6B65CB16A7C09F97.quest_subtitle: "交流发电机"
	quest.6B65CB16A7C09F97.title: "让我们来发电！"
	quest.6BE34726A5C658EE.quest_desc: [
		"&a和&e屹立不倒之戒&a、&e十字项链&a相性极佳。"
		""
		"&c回复会被诅咒效果阻止，会被诸神黄昏词条封印。"
	]
