	quest.33D3B2D19D5B56C7.quest_subtitle: "无需解锁路径点就能传送"
	quest.33E62BE9423ADFE5.quest_desc: [
		"&e机械动力&a是以&6机械传动&a、&6动态结构&a、&6趣味物流&a、以及&6各种独特产品&a等等为特色的&8&m建筑装饰&r&a工业模组。"
		""
		"&a该模组相比于传统工业模组&6更美观、更有趣，也更简单易上手&a。因此，请对自己有些信心，&e轻松愉快地享受机械动力的乐趣吧！"
		""
		"&a本整合包还提供了&6大量附属&a扩展玩家的体验！"
		"&c                                                                             这里还有第二页哦↓"
		"{@pagebreak}"
		"&a在&e本章节的任务&a中，除第一页外，&6其他分页&a均用于&6更深入的说明&a。"
		""
		"&e机械动力&a拥有官方的&6思索&a功能，可&6直观地学习&a各个元件的使用细节。&7（游戏里内置官方wiki说是）"
		""
		"&a本篇任务仅作为入门指引，以防你面对琳琅满目的方块，而感到无从下手。因此&6不需要也不建议&a读完全部任务文本。"
		""
		"{ \"text\": \"点击跳转：思索\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"06B15B851CF8C678\" } }"
		"{@pagebreak}"
		"&a一些任务要求是&e进度&a，有时以&e建筑工茶饮&a作为图标。&6并不需要拿到这杯茶&a，&m拿了也行&r。"
	]
	quest.33E62BE9423ADFE5.quest_subtitle: "齿轮传动的工业之旅"
	quest.33E62BE9423ADFE5.title: "&e欢迎来到机械动力"
	quest.34812373C595A7D1.quest_desc: ["&a对策&c排斥&a、&c吸引&a。"]
	quest.34812373C595A7D1.title: "绝缘"
	quest.350F017B80A1EC55.quest_subtitle: "骄兵必败，败兵必哀，哀兵必胜，所以骄兵必胜。"
	quest.350F017B80A1EC55.title: "&6【核心】&r傲慢诅咒"
	quest.354040B445266F74.quest_desc: [
		"&e鸡&a拥有&6抗性保护4&a时可以抵抗一次&6低等级&e监守者&a的音爆攻击。&e神龟药水&a可以做到。"
		""
		"&a法术&e神圣守护&a的&6伤害吸收&a效果也提供有效保护。"
		"{@pagebreak}"
		"&a用&e恶意吸收宝珠&a确保&6无等级&e监守者&a生成。"
		""
		"&a可利用&e流体系统&a的&6药水喷洒&a来节约&e神龟药水&a。"
		""
		"&a获得后可合成&e音爆枪&a来产生常规伤害音爆。可以被&e机械手&a使用。"
	]
