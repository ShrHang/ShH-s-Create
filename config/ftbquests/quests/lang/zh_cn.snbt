	quest.06B15B851CF8C678.quest_desc: [
		"&a打开&6物品栏&a，将&b鼠标光标&a放在&e机械动力物品&a上，长按[w]键以进行&6思索&a，学习&e物品&a的官方用法。"
		"{image:kubejs:textures/ftbquests/ponder-1.png width:150 height:80 align:center}"
		"{image:kubejs:textures/ftbquests/ponder-2.png width:180 height:100 align:center}"
		""
		"&a任务只负责告诉你&3要做什么&a，而思索可以告诉你&3能做什么&a。"
		""
		"&c有不会的先 思索"
		"&c有不会的先 思索"
		"&c有不会的先 思索"
