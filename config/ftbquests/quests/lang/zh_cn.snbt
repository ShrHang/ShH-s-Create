	quest.0B5D4E8A38187BBD.quest_desc: [
		"&a最基础的法术书，在此基础上可以升级成更高级的法术书"
		""
		"&e整合包修改了法术书的合成配方，但是并未禁用法术书作为战利品的掉落。"
		""
		"&e如果您是一位老练的魔法师，您应该知道如何获取它们。"
	]
	quest.0B5D4E8A38187BBD.quest_subtitle: "也许会是您的第一本法术书"
	quest.0C036F39A5D7474D.quest_desc: [
		"&a您可以把&d面团&a和&d裹馅面食&a右键放入蒸笼以蒸制成&d馒头&a和&d包子&a。"
		""
		"&a蒸笼需要放置在&c热源&a上才能工作，您也可以&6在蒸笼上继续垒放蒸笼&a，或&6潜行右键蒸笼&a以&e封顶&a。"
		""
		"&a热源最高可以作用于&e8&a层高度的蒸笼，当蒸笼&c接收到热源且上方封顶时&a才会开始蒸制。"
		""
		"&a蒸制完成的蒸笼会有&f粒子效果&a作为提示。"
	]
	quest.0C7FAE5FB0D2C3BE.quest_desc: [
		"手持&7空的烈焰人燃烧室&r右键&6烈焰人&r,即可将烈焰人装进燃烧室。"
		"{image:kubejs:textures/ftbquests/catch_blaze.png width:100 height:150 align:center}"
	]
	quest.0C7FAE5FB0D2C3BE.quest_subtitle: "黄铜时代的起点，人们掌握了更优质的加热源。"
	quest.0C7FAE5FB0D2C3BE.title: "&6获取烈焰人燃烧室"
	quest.0C8A0ED4B1C6AC73.quest_desc: ["&a因&6分裂&a产生的次体不掉落词条。"]
	quest.0CDBF046E90EA142.quest_desc: [
		"&a不会被烧毁。"
		""
		"&e结晶扩散法杖&a可以作为&e绿宝石&a再生的基础。利用&e机械手&6穿透点击&a被六个&e石头/深板岩&a包围的&e绿宝石块&a，即可生成七个&e绿宝石矿石/深层绿宝石矿石&a。"
		""
		"&a别忘记搭配&6时运&a等附魔，&c否则就是9换7了。"
		"{@pagebreak}"
		"&6精准采集&e深层绿宝石矿石&a，使用&e粉碎轮&a处理也可以稳定得到正收益。&e绿宝石矿石&a则不稳定。前者平均每块产出&62.25颗绿宝石&a，后者平均每块产出&61.75颗绿宝石&a。"
	]
	quest.0CE2992B71AA0ED2.quest_desc: [
		"{@pagebreak}"
		"&a可以用&e鼓风机&a把路过的&e恶魂&a吸下来。&c&m暮色恶魂体验卡&r&a。满速&e鼓风机&a的拦截高度为&d20格&a。"
		""
		"&c若加装分散网，捕获高度实际上会降低。"
