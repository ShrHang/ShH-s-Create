	quest.4033EE1DF4034D11.quest_subtitle: "击杀死者之王掉落"
	quest.40C24F458ED9FEC3.quest_desc: ["找到铁魔法的法术卷轴，准备开始你的魔法师之旅。"]
	quest.40C24F458ED9FEC3.title: "找到法术卷轴"
	quest.410D164F96E48678.quest_desc: [
		"&a使用&6扭曲诅咒之戒&a或&6圣光守护之戒&a对策。"
		""
		"&a奇异饰品的&6解毒容器&a也可降低影响。实际上足以阻止画面扭曲。"
	]
	quest.410D164F96E48678.quest_subtitle: "扭~曲~"
	quest.416FB0A75240450E.quest_desc: [
		"&a为&e鼓风机&a安装&e分散网&a，产生更强的吸取、推动力。"
		"{@pagebreak}"
		"&a风力将转为以&e分散网&a为中心，&6半径为r的球体&a，但捕获范围缩小为&6边长为r的立方体&a。"
		""
		"&a被捕获后，离&e分散网&a越近，每帧施加的速度越大。可以在&e不同分散网之间&a叠加，产生更大的力量。"
		"{@pagebreak}"
		"&a若&6未被捕获&a且未&b潜行&a，则在进入&6立方区域&a后，才开始被&e分散网&a影响，直到脱离&6球体区域&a或&b潜行&a。"
		""
		"&a位于挡风方块后总是不受&e分散网&a捕获或影响，这些方块包括&e分散网&a和&e鼓风机&a本身。"
		"{@pagebreak}"
		"&d半径r(格)=（17 * 转速(RPM) ) / 256 +3"
		""
		"&d加速度v(格/tick^2) = ( 半径r(格) - 对中心的距离 ) / 8"
		""
		"&a若实体为&6掉落物&a,上式加速度v还会再额外除以4，即掉落物加速更慢。"
	]
	quest.416FB0A75240450E.quest_subtitle: "强劲的推拉装置"
	quest.429A439C0A6589AD.quest_desc: ["&a合成需要将&e黑曜石&a通过&e粉碎轮&a、&e注液器&a和&e动力冲压机&a的&6序列装配&a加工。"]
	quest.429A439C0A6589AD.quest_subtitle: "合成列车机壳和高端装备的材料"
	quest.429CB3F060E6199C.quest_desc: [
		"&a处于&d320格&a及以上，处于&6自然燃烧&a的&e幻翼&a死亡即掉落。"
		""
		"&a无需让幻翼受到火焰伤害，只要它已经被&6点燃&a，即使它有&6抗火&a也会掉落。也不需要玩家击杀。"
		""
		"&a可以和&e裂空结晶&a一起掉落。"
	]
	quest.42A010BDA9943D1D.quest_desc: [
		"&a不会被烧毁。"
		""
		"&a可以试试&6恶魂刷怪塔&a或&e机械动力&a产线。"
	]
	quest.42A11C13B5873E38.quest_desc: ["&a佩戴&d混沌抢夺宝珠&a击杀&c榴弹III&a词条怪物获取。"]
	quest.42C2A3AAD4DAADBE.quest_subtitle: "全都扒光光！"
	quest.4357B662BA244220.quest_desc: [
		"&a生物的&e无敌帧&a是0.5s，&6攻击速度>2&a时拳套即有效。"
		""
		"&a与法术&e急迫&a和奇异饰品&e狂野之爪&a相性良好。"
		""
		"&a搭配潘多拉之咒的&e疾风刺&a可显著提高输出效率。"
	]
	quest.4357B662BA244220.quest_subtitle: "抽帧抽走了无敌帧"
	quest.43D22963AB7E5295.quest_desc: [
		"&e反转齿轮箱&a能利用&e红石信号&6反转转向。"
		"{@pagebreak}"
		"&a当接收到&e红石信号&a时，输出端将&6反转转向&a。"
		""
		"&a无信号时，&6恢复转向&a，相当于一个&e传动杆箱&a。"
	]
	quest.43D22963AB7E5295.quest_subtitle: "搭配红石来控制转向"
	quest.4420075730625D44.quest_desc: [
		"&a一般搭配傲慢诅咒，应对因&6额外难度&a而等级更高的怪物。"
		""
		"&a也可在需要保持自身低等级时，清理遗留的高等级怪。"
		"{@pagebreak}"
		"&a娱乐性质的，&a可在高等级怪出现后，利用&e神圣之光&a或&e恶意净化药水&a让等级清零。&m&8恃 弱 凌 强"
		""
		"&c注意：等级清零不可逆，最好存一些瓶装恶意。通常，维持等级发挥傲慢诅咒实际更好。"
	]
	quest.4420075730625D44.quest_subtitle: "恃强凌弱之人最害怕弱者的反抗。"
	quest.445564C4C0A6A27F.quest_desc: [
		"&b莱特兰·扩充&a是一个为&d莱特兰其他模组&a提供了大量&c特殊的材料&a模组。"
		""
		"&a您可以通过完成物品描述所写的挑战去获取对应的物品或者材料。"
		""
		""
		"&e本章节任务将为您提供获取这些特殊材料的方法。"
	]
	quest.445564C4C0A6A27F.quest_subtitle: "说是扩充，实际上是莱特兰系列的通用前置。"
	quest.448FD101F7DE41CE.quest_desc: [
		"&a其伤害受&c高怪物等级的伤害增强影响&a,且该伤害可触发&c身上其它词条&a的效果。"
		""
		"&5魔法免疫&a，乃至&5无敌帧&a，都无法阻止&c杀戮光环&a施加效果。"
		""
		"&a和&c诸神黄昏&a搭配时近战威胁显著上升。"
	]
	quest.448FD101F7DE41CE.quest_subtitle: "杀~戮~光~环~！"
	quest.44B65A038A221311.title: "机电动力"
	quest.44CCF84445AFC4A2.quest_desc: [
		"&a机械动力中的高级材料之一，经由&6序列装配&a合成而来。"
		""
		"&a同时也是&e许多高级原件的重要原材料&a。"
	]
	quest.44CCF84445AFC4A2.quest_subtitle: "高新技术"
	quest.4519D0B28AD8DFA1.quest_desc: ["&b魔法伤害&a可以击穿护甲。"]
	quest.4519D0B28AD8DFA1.quest_subtitle: "简单粗暴的数值。"
	quest.455E8000401973BE.quest_desc: [
		"&e阀门手轮&a是&6手动&a的&6动力源&a，数值和&e手摇曲柄&a一致。"
		""
		"&c但不能连续旋转，不能连续产出应力。"
		""
		"&a它主要用于&6动态结构&a↓"
		""
		"{ \"text\": \"点击跳转：阀门手轮\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"74C1FF06504E18AE\" } }"
		"{@pagebreak}"
		"&e阀门手轮&a单次持续时间并不固定，而是取决于旋转角度。&e阀门手轮&a的转速换算即&d192°/s&a，单次持续时间可以超过&e手摇曲柄&a的&d0.5s&a。"
		""
		"&d转速32RPM&a"
		""
		"&d应力产出256su"
		""
		"&a使用后进入短时间的冷却，连续点击也不转动。"
	]
	quest.455E8000401973BE.quest_subtitle: "半吊子动力源"
	quest.455E8000401973BE.title: "铜阀门手轮：动力源用途"
	quest.4640FE4E2D3DE60A.quest_desc: [
		"&6无等级&e凋灵&a仅&d300血&a，其半血前一箭秒杀即可。"
		""
		"&a最好打&6无等级&e凋灵&a，否则&6排斥&a词条会完全阻止其受到弹射物伤害。"
		"{@pagebreak}"
		"&a用&e恶意吸收宝珠&a确保&6无等级&e凋零&a生成。"
		""
		"&a半血下的&e凋灵&a可由&e潜影弹&a(包括&6潜影&a词条生成的)击穿防护掉落。"
		""
		"&a灾变的&e激光加特林&a也可以击穿并掉落。"
		""
		"&c然而万能的虚空凝视击穿不了。"
	]
	quest.46AA61D3F63ADDE8.quest_desc: [
		"&a如果您并不了解如何使用&eJEI&a，您可以参照这个任务了解基础使用方法。"
		""
		"&a如果您很清楚如何使用JEI，&e请不必在这里浪费时间&a。"
		"{@pagebreak}"
		"&a打开&e物品栏&a(&b默认E键&a)，界面右侧的&6一堆物品和搜索框&a就是&eJEI&a——的一部分。"
		"{image:kubejs:textures/ftbquests/start-jei.png width:200 height:115 align:center}"
		"&a你可以使用它来搜索物品的&e相关信息&a、&e来源&a和&e用途&a。"
		"{@pagebreak}"
		"&a你可以直接在&e输入框&a搜索&e对应物品的名称（拼音缩写也可以）&a，来查找对应物品。"
		"{image:kubejs:textures/ftbquests/search-jei.png width:150 height:106 align:center}"
		"&a此时左键物品，即可查看&e物品的来源&a。"
		"{image:kubejs:textures/ftbquests/search-jei-1.png width:145 height:100 align:center}"
		"&a右键物品，即可查看&e物品的用途&a。"
		"{image:kubejs:textures/ftbquests/search-jei-2.png width:125 height:100 align:center}"
		"{@pagebreak}"
		"&e当然，你也可以直接&e对着背包内的物品&a进行查找。将&b鼠标&a指向物品后："
		"{image:kubejs:textures/ftbquests/pack-search-jei.png width:120 height:120 align:center}"
		"&a对着物品&b按下R键&a，显示&e物品的来源&a。"
		"{image:kubejs:textures/ftbquests/pack-search-jei-1.png width:100 height:100 align:center}"
		"&a对着物品&b按下U键&a，显示&e物品的用途&a。"
		"{image:kubejs:textures/ftbquests/pack-search-jei-2.png width:100 height:100 align:center}"
		"{@pagebreak}"
		"&a在JEI的界面中，您可以&e继续按键查看显示的物品的来源与用途&a。"
		"{image:kubejs:textures/ftbquests/jei-search-jei.png width:100 height:100 align:center}"
		"&7按左键或U键查看到的来源"
		"{image:kubejs:textures/ftbquests/jei-search-jei-1.png width:100 height:100 align:center}"
		"{@pagebreak}"
		"&a在配方界面，上方是&e合成配方类型&a(如&e合成&a)，左侧边框是&e工作方块&a(如&e工作台&a)。"
		"{image:kubejs:textures/ftbquests/gui-search-jei.png width:100 height:100 align:center}"
		"&e每种配方种类&a都需要相应的&e工作方块&a和其他&6特定条件&a才能实现。大多都可以在&eJEI&a中查到。"
		"{@pagebreak}"
		"&e书签&a用来快速查看配方。可在配方界面添加，也可通过&e物品栏&a左下方按键&6快速添加&a。"
		"{image:kubejs:textures/ftbquests/tag-search-jei.png width:100 height:100 align:center}"
		"&e书签&a显示在左上方，&eFTB功能&a的下方。"
		"{image:kubejs:textures/ftbquests/tag-search-jei-1.png width:100 height:100 align:center}"
		"&a你可以对着&6书签区域的物品&a按下&6[A]&a键，将其移出书签。"
	]
	quest.46AA61D3F63ADDE8.quest_subtitle: "查看物品的来源、用途，以及相关配方。"
	quest.46AA61D3F63ADDE8.title: "请务必掌握的知识：使用JEI"
	quest.46F55CE3728F1B92.quest_subtitle: "无限流体"
