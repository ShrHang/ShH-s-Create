	quest.758BC8937785B21D.quest_desc: [
		"&a在探索途中，您也许会收获到一些&d法术卷轴&a。"
		""
		"&a每一张卷轴都对应&b一种法术&a，拿在手上直接&e右键&a，可以直接释放对应的法术。"
		"&c（但是会消耗这张卷轴）"
		""
		"&a想要不消耗卷轴来释放法术，还请您查阅接下来的任务。"
	]
	quest.758BC8937785B21D.quest_subtitle: "您得以释放法术的根本"
	quest.78FC1D37DCC2C65D.quest_desc: [
		"&a佩戴这类饰品后&6击杀带有词条的怪物&a会获取对应的掉落物。"
		""
		"&e粗糙抢夺宝珠&a获取的大部分是原版的物品，而从&3魔能抢夺宝珠&a开始，玩家可以通过击杀带有词条的怪物获取大部分莱特兰扩充和恶意中的材料，"
		""
		"&c具体对应材料可以查看JEI。"
		"{image:kubejs:textures/ftbquests/charm_of_looting.png width:130 height:130 align:center}"
		""
		""
		"&a作为潘多拉饰品，这些抢夺宝珠也可以被放入潘多拉饰品串中。"
		"{image:kubejs:textures/ftbquests/charm_of_looting_in_pandora.png width:150 height:50 align:center}"
	]
