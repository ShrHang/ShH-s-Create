	quest.28CB99069C2B6416.quest_desc: [
		"&e机械动力&a产品，&a使用&e动力冲压机&6冲压&e金锭&a来获得。"
		"{@pagebreak}"
		"&a与获取&e铁板&a的方式一致。不要将它与&e黄铜板&a混淆。"
		""
		"{ \"text\": \"点击跳转：制造铁板\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"1FB411220A26B0E2\" } }"
	]
	quest.28CB99069C2B6416.quest_subtitle: "高级工具的关键材料"
	quest.28D0E8E0C045C9B8.quest_desc: [
		"&a秘银矿在主世界&eY≤38&a处生成，推荐挖掘高度为主世界Y=&e-50&a~&e-46&a处。"
		""
		"&a需要使用&d下界合金镐或更高挖掘等级的镐&a来开采，挖掘后掉落1块粗秘银&6（受时运影响）&a。"
		""
		"&7秘银矿不会生成在裸露的岩石表面。"
	]
	quest.28D0E8E0C045C9B8.quest_subtitle: "及其稀有的魔法矿物"
	quest.28DD61278EF8AA55.quest_desc: [
