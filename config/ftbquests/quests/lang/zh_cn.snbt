	quest.53A9570F1323BD81.quest_subtitle: "死因分析出来了，是自杀.jpg"
	quest.53BAB5CC16AC95C0.quest_desc: [
		"&a推荐使用&e能够持续造成伤害的药水或方块(如岩浆块、细雪等)&a来抵消一部分适应造成的影响。"
		""
		"&a使用&5冰刃&a、&5炎刃&a、&5撕裂之刃&a、&5虚空之触&a附魔对策。"
		""
		"&a一些可击穿&6抗性保护&a的伤害也能击穿此防护，包括&6破咒遗骨&a、&b虚空伤害&a、&b真实伤害&a等。"
	]
	quest.53BAB5CC16AC95C0.quest_subtitle: "久而久之，不正常也变得正常。"
	quest.54C2193D055BD22F.quest_desc: [
		"&a该流派法术对亡灵生物具有50%的增伤。"
		""
		"=================================="
		""
		"&a推荐法术："
		""
		"&e急迫&a：大幅加快吟唱速度和魔力恢复，同时提供攻速、移速、挖掘速度加成。"
		""
		"&e天使之翼&a:前期就能使用的鞘翅，赶路必备。"
		""
		"&e神圣守护&a：提供高额伤害吸收。"
		""
		"&e曳光弹&a：大幅提高法术命中率，优化手感。"
		""
		"&e治疗&a：瞬发治疗术，奶量充足，手感良好。"
	]
	quest.54C2193D055BD22F.quest_subtitle: "&e神圣&r流派代表物"
	quest.554E80B94490907E.quest_desc: [
		"&a将&6放置&a的&e原木&a用&e斧头&a右键&a去皮，手持&e安山合金&a右键&e去皮原木&a，将其封装&a为&e安山机壳&a。&6使用工具把它挖回手上&a。"
		"{@pagebreak}"
		"&6手持&e安山机壳&a右键&e齿轮&a、&e传动杆&a、&e传送带&a，可&6封装&a为&e齿轮箱&a或&e传动杆箱&a，作为装饰、避免碰撞。&e齿轮箱&a还具有独特的&6传动&a变化。"
	]
	quest.554E80B94490907E.quest_subtitle: "合成作业元件与传动元件的关键材料"
	quest.55B1EE12FB0F9449.quest_desc: ["&a快速获取瓶装恶意的手段。"]
	quest.55B1EE12FB0F9449.quest_subtitle: "量大管饱的恶意。"
	quest.55DEDCFB44C9F72E.title: "魔法免疫"
	quest.561CB1A791BF6EE4.quest_desc: [
		"&a能和其他&e链式齿轮箱&a组成独特的传动系统。"
		"{@pagebreak}"
		"&e链式齿轮箱&a需要构成&e传动箱组&a来传动。"
		""
		"&a一种传动类似&e小齿轮之间&a的咬合传动&a，由&6同向并列&a的链式齿轮箱组成&e传动箱组&a。&6转向一致，但只能摆直线&a。"
		""
		"&a可称为&6平行轴&a传动。"
		"{image:kubejs:textures/ftbquests/encased_chain_drive-1.png width:160 height:90 align:center}"
		"{@pagebreak}"
		"&a另一种传动是&e链式齿轮箱&a的特色。由&6两种朝向&a的链式齿轮箱&a形成&e传动箱组&a。可根据&6纹理&a来判断拼接的位置和朝向。"
		""
		"&a是一种&6异面垂直传动&a。"
		"{image:kubejs:textures/ftbquests/encased_chain_drive-2.png width:160 height:90 align:center}"
	]
	quest.561CB1A791BF6EE4.quest_subtitle: "另一位传动的好手，提供独特的传动方法"
	quest.56A8F476C3B11610.quest_desc: [
		"&a选择&6一个或多个装置&a，为&6驱动你的机器&a做准备。这些装置就是&6动力源&a。"
		"{@pagebreak}"
		"&e机械动力&a的能源&a为&d应力&a，&6动力源&a就是产生&d应力&a的&6元件&a。"
		""
		"&d应力&a不能直接存储，所以只需让&d应力产出速率&a>&d应力消耗速率&a。"
	]
	quest.56A8F476C3B11610.quest_subtitle: "产生应力的能源元件"
	quest.56A8F476C3B11610.title: "基础动力源"
	quest.56B2AB818F0E08EF.quest_desc: [
		"&d法术卷轴可以被装入法术书中。"
		""
		"&a当您&6在饰品栏装备法术书&a时，您可以&6按下[V]&a释放法术书中所装入的法术，并且&e不会消耗卷轴&a。"
		""
		"&a取而代之的，您将消耗&b法力值&a来释放法术，并且法术在释放后会&e进入冷却&a。"
		""
		"&a默认情况下，您可以&6按下[R]&a打开轮盘，或&6按下[ALT]+鼠标滚轮&a切换法术。"
		"{image:kubejs:textures/ftbquests/spell_table.png width:100 height:100 align:center}"
		""
		"&c如果您的法力值小于法术释放的要求，您将无法释放该法术。"
		""
		"{ \"text\": \"如果您不知道如何获得法术书，请点击这里\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0B5D4E8A38187BBD\" } }"
	]
	quest.56B2AB818F0E08EF.quest_subtitle: "法术卷轴的容器"
	quest.56B2AB818F0E08EF.title: "【2】法术书"
	quest.56BCED2FDD1D0F87.quest_subtitle: "我即天命"
	quest.56BCED2FDD1D0F87.title: "&6【核心】&r宝石手套"
	quest.57F6C4179811E160.title: "亲和戒指"
	quest.587C93005F045722.quest_subtitle: "流体传输的基本途径"
	quest.58B909F699F1219A.title: "基础物流元件"
	quest.59ED871A613FEADE.quest_subtitle: "附魔工业的基础"
	quest.5A13E6C10C18D5C3.quest_desc: [
		"&a能工作的元件就是&6作业元件&a，用来加工的元件就是&6加工作业元件&a。&6妥善利用它们&a是&e机械动力&a的&6主要玩法之一&a。"
		"{@pagebreak}"
		"&6作业元件&a消耗&d应力&a,&6作业速率&a随着&d转速&a的上升而上升。&d应力消耗&a也是如此。"
		""
		"&d转速&a的上限是&d256RPM&a。1RPM即每分钟转1圈。"
		"{@pagebreak}"
		"&e动力源&a、&e传动元件&a和&e作业元件&a构成一个&e应力网络&a。"
		""
		"&c注意：作业元件接入网络时，就会消耗应力，无论是否运行。"
		""
		"&c当应力消耗大于应力产出时，应力网络将中止所有的传动与作业，称为应力过载。"
	]
	quest.5A13E6C10C18D5C3.quest_subtitle: "早期可用的加工机器"
	quest.5A13E6C10C18D5C3.title: "基础加工作业元件"
	quest.5A53D8AA737480DC.quest_subtitle: "可以与符文合成对应效果的升级法术球，用于强化装备。"
	quest.5A6D0789E9704F94.quest_subtitle: "点对点，传送生物实体"
	quest.5AB0D3993583910C.quest_desc: [
		"&a使用&e缓慢&a、&e禁锢&a状态效果对策。"
		""
		"&a使用&6禁锢诅咒之戒&a对策。"
	]
	quest.5AB0D3993583910C.quest_subtitle: "跑得超快！"
	quest.5B4E1E5F9AB883F2.quest_desc: ["&c不能重复穿戴。"]
	quest.5B4E1E5F9AB883F2.quest_subtitle: "增加头饰栏位"
	quest.5B4E1E5F9AB883F2.title: "&3异&5色&6眼镜"
	quest.5C88216A88C8A529.quest_desc: [
		"&a使你可以&6快速手动合成&a某种物品，但只在&6固定地点&a提供便利。&6早期批量合成&a时有用。"
		""
		"&a不要将其与&e蓝图&a混淆。"
		""
		"{ \"text\": \"点击跳转：空白蓝图\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2682D13C14C3B547\" } }"
		""
		"{@pagebreak}"
		"&e合成蓝图&a可放置在方块的&6任意一面&a。"
		""
		"&a在平面上放置时，如果空间足够，一张合成蓝图就可以存放&d2*2/3*3&a个配方，实现节约。"
		"{image:kubejs:textures/ftbquests/crafting_blueprint-1.png width:200 height:150 align:center}"
		""
		"&c注意：谨防弹射物。&m比如女仆和女仆妖精的弹幕&r&r"
		""
		"{@pagebreak}"
		"&a放置后，&b右键&a打开面板&a，填入&e合成表&a。"
		""
		"&a技巧：&6配置合成表&a时，可使用&eJEI&a。"
		"{image:kubejs:textures/ftbquests/crafting_blueprint-2.png width:150 height:145 align:center}"
		""
		"&a在&eJEI&a打开&e物品合成表&a后，&a点击&b“+”&a转移物品即可。"
		"{image:kubejs:textures/ftbquests/crafting_blueprint-3.png width:150 height:50 align:center}"
		""
		"&a该方法&6自动提供标签过滤&a，应优先使用。"
		"{ \"text\": \"点击跳转：必须掌握的知识：使用JEI\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"46AA61D3F63ADDE8\" } }"
		""
		"{@pagebreak}"
		"&a完成配置&a且&6背包内有原料&a时，对&e合成蓝图&b右键&a可合成&e一个物品&a，&b潜行右键&a可合成&e一组&a。"
		"{image:kubejs:textures/ftbquests/crafting_blueprint-4.png width:150 height:150 align:center}"
	]
	quest.5C88216A88C8A529.quest_subtitle: "手动合成辅助工具"
	quest.5CB83B207F4279BA.quest_desc: [
		"&a想要连接不同的电源、用电器，我们需要使用&b连接器&a和&b线(轴)&a来将它们连接起来。"
		"{@pagebreak}"
		"&a目前，模组提供了&b铜线（轴）&a、&b金线（轴）&a、&b琥珀金线（轴）&a、&b有节日灯的线轴&a这四种线（轴）和小型连接器、大型连接器、发光小型连接器这三种连接器。"
		""
		"&a通过&b连接器&a，我们将FE从电源中导出，或者导入用电器。连接器都有&b输入&a、&b输出&a、&b无&a三种模式，通过使用&e扳手&a来调整。连接器可以储存一定量的FE，大型连接器的容量大于小型连接器。"
		"{@pagebreak}"
		"&a通过线，我们可以将各连接器串联，实现FE的传输。"
		""
		"&a大型连接器之间只能使用&b金线&a和&b琥珀金线&a连接。小型连接器和发光小型连接器只能连接&b4&a条线，大型连接器可以连接&b8&a条线。"
	]
	quest.5CB83B207F4279BA.quest_subtitle: "将电力导出的方法"
	quest.5CB83B207F4279BA.title: "让我们开导！"
	quest.5DF518B27AF3EEFB.quest_desc: ["&a佩戴&d混沌抢夺宝珠&a击杀&c吸引&a词条怪物获取。"]
	quest.5E14A5BED2F9E415.title: "深渊术士套装"
