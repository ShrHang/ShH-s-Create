	quest.0FD80C44EB48FBDC.quest_desc: [
		"&a每当玩家在一个区块内击杀足够多的怪物时，会获得一个&e恶意吸收宝珠&a。"
		""
		"&a使用后，可以创造一个没有恶意难度的区域，区域内生成的怪物不再具有&5恶意等级&a。"
		""
		"&a想要使用它，您需要&6副手持有恶意探测器，并将侦测眼镜佩戴在饰品栏。"
	]
	quest.0FD80C44EB48FBDC.quest_subtitle: "恶意净空"
	quest.104ECC8EAADA9624.title: "流浪法师套装"
	quest.10FB99A4C7C763FF.quest_desc: ["&a提供&b大量法力上限&a，同时也提供更多利好法师的属性。"]
	quest.10FB99A4C7C763FF.quest_subtitle: "法师的护甲"
	quest.10FB99A4C7C763FF.title: "法师套装"
	quest.1199A5AC10873CF3.quest_desc: [
		"&a主要用于&6破坏方块&a或&6伤害实体&a。能破坏&6生存模式能破坏的方块&a（除了&e蜘蛛网&a等无碰撞体积的），且能&6无视护甲&a造成伤害。"
		""
		"{@pagebreak}"
		"&6破坏速度&a和&6伤害&a取决于&6自身转速&a和&6在动态结构上的移速&a。"
		""
		"{@pagebreak}"
		"&6非动态结构上&a的&e动力钻头&a有独特机制，针对&6刷石&a。"
		""
		"&a对于&6由流体产生方块&a的&6刷石结构&a，如&e水+岩浆=圆石&a，若其产出方块（如&e圆石&a）的正下方存在&e开放容器&a时，触发该机制。"
		""
		"&a该机制中，&6刷石产物&a将&6不被破坏&a，改为&6生成对应物品&a，置入下方容器中。&c若下方容器已满，则什么都不做，掉落物也没有。"
		""
		"&a效率可随&6钻头数量&a叠加，只要下方容器没满。"
		"{@pagebreak}"
		"&e动力钻头&a可以含水，很适合圆石刷石机。"
		""
		"&a独特机制对&e石灰石&a、&e熔渣&a的刷石结构都可用，但&e玄武岩&a的刷石结构需要&e灵魂土&a做地板，故无法应用。"
	]
	quest.12174CFBAEEBADA7.quest_desc: [
		"&a使用&6侦测眼镜&a对策。"
		""
		"{ \"text\": \"点击跳转：侦测眼镜\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"17BCF9DCB1C16EC1\" } }"
	]
	quest.12174CFBAEEBADA7.quest_subtitle: "&m&8看不见我看不见我看不见我看不见我看不见我"
	quest.126141DE9CB118AD.quest_desc: [
		"&a做一台&e动力冲压机&a。这是&6最早可做，日后也很有用&a的&e加工作业元件&a。"
		"{@pagebreak}"
		"&a请先查阅&e动力冲压机&a的思索内容。"
		""
		"&a将&e动力冲压机&a放置在&e置物台&a、&e传送带&a，、&e工作盆&a上方的第二格中，即可进行加工。"
		""
		"&a对于&6冲压&a，可使用&e置物台&a、&e传送带&a等进行，但不能是&e工作盆&a。"
		""
		"&6塑形&a和&6自动压缩&a则仅限&e工作盆&a。有&6加热条件&a时，在&e工作盆&a下方放置并点燃&e烈焰人燃烧室&a。"
		""
		"&6自动压缩&a兼容所有&d2*2/3*3&a的&6单一材料配方&a。"
		"{@pagebreak}"
		"&6冲压&a时，与容器间不能有方块。但&6塑性&a和&6自动压缩&a可以与&e工作盆&a之间有方块。"
		""
		"&d应力消耗8su/RPM&a。"
		""
		"&a传动形式&a相当于&e传动杆箱&a，可以连成一条线。"
	]
	quest.126141DE9CB118AD.quest_subtitle: "最基础也最常用的加工机器"
	quest.131378356A4C1C03.quest_desc: [
		"&a佩戴后玩家将被视为处在&b水中\\\\雨中&a。"
