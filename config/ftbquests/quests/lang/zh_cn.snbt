	quest.4F04A65311FE539C.quest_subtitle: "其实是【幻想杀手】"
	quest.4F04D8CCD3277063.quest_desc: [
		"&e置物台&a可以接收&e一种物品&a，并储存&d至多一组&a在其上表面。"
		"{@pagebreak}"
		"&a手持物品&b右键点击&e置物台&a，即可将&e手持物品&a与&e置物台上的物品&6交换&a或&6合并&a。当&e掉落物&a出现在&e空置物台&a上方时，也会被&e置物台&6吸收储存。"
		"{@pagebreak}"
		"&a在置物台上加工时的&e产品&a可以缓存&d8组&a。"
		"&c注意：已放有物品的置物台不接收右键点击和加工产出以外的物品输入，即使这些物品可以堆叠。"
	]
	quest.4F04D8CCD3277063.quest_subtitle: "暂存物品的小容量开放容器"
	quest.4F1F84486959237F.title: "惊悚南瓜套装"
	quest.4FCCF74457D8144F.quest_desc: [
		"&a利用&e潘多拉之咒&a的&e七个诅咒&a来叠加&6现实指数&a。将诅咒放入&e潘多拉项链&a或&e潘多拉手环&a后装备即可。"
		"{@pagebreak}"
		"&e黄铜&a和&e锌&a的盔甲套装，以及&e安山&a、&e黄铜&a的&e喷气背包&a与&e外骨骼盔甲&a都提供少量现实指数。"
		""
		"&a后期可以使用&e破境剑符&a。"
		""
		"&d虚空凝视&a可以击穿。"
	]
