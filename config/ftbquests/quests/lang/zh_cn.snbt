	quest.6448EE01DD79E42F.quest_desc: ["&a可以在物品栏界面按&b鼠标中键&a快速排列整理。"]
	quest.6448EE01DD79E42F.quest_subtitle: "知晓这些按键分别对应着什么功能。"
	quest.6448EE01DD79E42F.title: "需要掌握的知识：基础按键绑定"
	quest.64C3BF58E57323D2.quest_desc: [
		"主要写了一些在原模组基础上的改动。"
		""
		"&l&6总目录"
		"1.&d游戏机制"
		"2.&c装备数值"
		"3.&b生存探索"
		"4.&e机械动力"
		"5.&a辅助功能"
		"{@pagebreak}"
		"游戏机制："
		""
		"世界高度限制变为620格。"
		""
		"调整了莱特兰恶意大部分词条的数值和怪物成长曲线，关闭了区块难度、距离难度、维度难度，仅保留玩家自身的难度等级。"
		""
		"调整了灾变boss的恶意数据包词条配置，降低了难度。"
		""
		"调整了莱特兰扩充材料的部分获取方式，降低了获取难度。"
		""
		"启用了莱特兰扩充免疫类附魔与空间碎片。"
		"{@pagebreak}"
		"装备数值："
		""
		"增强了大多数装备数值,使玩家在前期就有很强大的战斗力。"
		""
		"增强了铁魔法的法术数值，使其跟上恶意带来的数值膨胀。"
		"{@pagebreak}"
		"生存探索："
		""
		"加入了Tom的简易存储。"
		""
		"加入了沉浸式飞机和指路石，便利交通。"
		""
		"加入了机械动力区块加载器。"
		""
		"加入了农夫乐事，便于制作更多食物。"
		"{@pagebreak}"
		"机械动力："
		""
		"添加了附魔工业、CCA、实用扩展等附属模组。"
		""
		"物品保险库的容量从20格变为64格。"
		""
		"添加了矿物量产配方，允许量产钻石、下界合金、青金石、锌、铜。"
		""
		"添加了铁魔法与机械动力的联动配方。"
		""
		"{@pagebreak}"
		"辅助功能："
		""
		"加入tweakeroo的neoforge移植版，默认[X+C]打开配置。"
		""
		"加入机械动力：赛博护目镜，无需佩戴工程师护目镜即可看到机械动力详细数据，默认[Alt+J]打开配置。"
	]
