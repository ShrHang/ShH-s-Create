	quest.5E2D39EB6D39D681.quest_subtitle: "增加背饰栏位"
	quest.5E2D39EB6D39D681.title: "三&4色&8披&6风"
	quest.5E489B1EF65A6F5F.quest_desc: [
		"&a佩戴&e粗糙抢夺宝珠&a，击杀带有&c重力&a或者&c月步&a词条的怪物，获取龙息。"
